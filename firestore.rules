rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Require authentication for ALL access by default
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Users can only modify their own profile, but anyone logged in can read it
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
      
      // Allow users to manage their own 'following' subcollection
      match /following/{targetId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Global Webtoons Registry - anyone can read, only authenticated users can write
    match /globalWebtoons/{webtoonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      
      // favoritedBy subcollection - users can manage their own favorite entries
      match /favoritedBy/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // User Libraries - users can read any library, but only write their own
    match /userLibraries/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
      
      // Allow reading webtoon entries within any user's library, but only write own
      match /webtoons/{webtoonId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == userId;
      }
    }

    // Activities feed - anyone can read, only authenticated users can write
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Follow Requests - requester and target can read/write their own requests
    match /followRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.requesterId == request.auth.uid || resource.data.targetUserId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.requesterId == request.auth.uid || resource.data.targetUserId == request.auth.uid);
    }
  }
}